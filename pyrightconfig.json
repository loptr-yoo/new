{
  "include": ["backend"],
  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "frontend/node_modules",
    "frontend/dist", "**/node_modules", "**/.*"
  ],
  "venvPath": "./backend",
  "venv": ".venv",
  "typeCheckingMode": "basic",
  "pythonVersion": "3.10",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false
}
